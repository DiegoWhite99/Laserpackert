<?xml version="1.0" encoding="utf-8"?>
<!--
    Variante para horizontal: en portrait la unica columna aprovecha bien el
    ancho, pero en horizontal deja media pantalla vacia a los lados. Aqui el
    formulario y la vista previa van lado a lado (mismos ids que el layout
    normal, asi que MainActivity no cambia).

    El ConstraintLayout de raiz + layout_constraintWidth_max limitan y centran
    todo el conjunto en tablets muy anchas, igual que en el layout de
    portrait: sin eso, en un tablet de 12" en horizontal el formulario y la
    vista previa quedan absurdamente estirados de borde a borde.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintWidth_max="960dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="20dp">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitStart"
                    android:src="@drawable/logo_divergency" />

                <TextView
                    android:id="@+id/textVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:textSize="11sp"
                    android:textColor="#999999"
                    android:text="v1.0" />

                <TextView
                    android:id="@+id/textEstadoCable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:padding="10dp"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:text="Comprobando el cable…" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Plantilla"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerPlantilla"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombres (uno por línea)"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/editNombres"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="4"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapWords"
                    android:hint="Diego Castelblanco"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/botonGenerar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Generar y enviar a LaserPecker" />

                <TextView
                    android:id="@+id/textEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#666666" />

            </LinearLayout>

            <ImageView
                android:id="@+id/imagenVistaPrevia"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:minHeight="260dp"
                android:background="#EEEEEE"
                android:scaleType="fitCenter"
                android:contentDescription="Vista previa" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
